					'''
			}

			MusicBoxMetamorphosis: {
				DisplayName: Music Box (Ophiopede)
				Tooltip: Badassbunnyz - Metamorphosis
			}

			MusicBoxTheFly: {
				DisplayName: Music Box (Ophiofly)
