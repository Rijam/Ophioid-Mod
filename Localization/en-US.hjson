			}

			OphiopedeRelic: {
				DisplayName: Ophiopede Relic
				Tooltip: ""
			}

			OphioflyRelic: {
				DisplayName: Ophiofly Relic
				Tooltip: ""
			}

			DeadFungusbug: {
				DisplayName: Dead Fungusbug
				Tooltip:
					'''
					'A putrid stench comes from the thing you just made, it might attract something...'
					Summons Ophiopede
					'''
			}

			InfestedCompost: {
				DisplayName: Infested Compost
				Tooltip:
					'''
					'An amalgamation of organic vileness'
					Summons Ophiopede?
					'''
				SummonMessage: The air becomes stale and moist around you.
			}

			LivingCarrion: {
				DisplayName: Living Carrion
				Tooltip:
					'''
					'A putrid stench comes from the thing you just made, it might attract something...'
					Summons Ophiopede
					'''
			}
		}

		NPCs: {
			EvenMoreVileSpit.DisplayName: Even More Vile Spit

			FlyMinion: {
				DisplayName: Ophioid Fly Minion
				Bestiary: Small Ophioid flies
			}

			FlyMinionCacoon: {
				DisplayName: Coocoon Carriers
				Bestiary: These small Ophioid flies carry the Ophiocoon to protect the Ophiofly
			}

			Ophiocoon: {
				DisplayName: Ophiocoon
				Bestiary: Ophiopede metamorphosizes into Ophiofly!
				DeathMessage: The Ophiofly hatches from the Cocoon!
			}

			MetaOphiocoon.DisplayName: Ophiocoon

			Ophiofly: {
				DisplayName: Ophiofly
				Bestiary: The fight against Ophiofly.

				BossChecklistIntegration: {
					EntryName: Ophiopede & Ophiofly
					SpawnInfo: Use an [i:OphioidMod/InfestedCompost] at any time after beating Ophiopede
					DespawnMessage: Ophioid slinks back into its hidden nest
				}

				DeathMessage: The {0}'s abomination is no longer felt, Ophioid is defeated!
			}

			OphiopedeHead: {
				DisplayName: Ophiopede
				Bestiary: The first fight against Ophiopede.

				BossChecklistIntegration: {
					SpawnInfo: Use a [i:OphioidMod/DeadFungusbug] or [i:OphioidMod/LivingCarrion] at any time
					DespawnMessage: Ophiopede tunnels away
					EntryName: Ophiopede
				}

				DeathMessage: The infested worm is defeated, but you can still feel the presence of the {0}'s abomination.
			}

			OphiopedeBody.DisplayName: Ophiopede
			OphiopedeTail.DisplayName: Ophiopede

			OphiopedeHead2: {
				DisplayName: Ophiopede
				Bestiary: The second fight against Ophiopede.
